{
  // 组件自动引入：页面里直接写 <wd-button>、<game-card>，不用 import
  // wd- 开头的来自组件库；src/components/xxx/xxx.vue 会被自动识别为 <xxx>
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  // 路由表：第一项是启动页。新增页面要在这里注册
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "球局",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/group/index",
      "style": {
        "navigationBarTitleText": "群组"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/game/detail",
      "style": {
        "navigationBarTitleText": "场次详情"
      }
    },
    {
      "path": "pages/game/create",
      "style": {
        "navigationBarTitleText": "新建固定局"
      }
    },
    {
      "path": "pages/bill/index",
      "style": {
        "navigationBarTitleText": "费用结算"
      }
    },
    {
      "path": "pages/group/detail",
      "style": {
        "navigationBarTitleText": "群组"
      }
    },
    {
      "path": "pages/group/join",
      "style": {
        "navigationBarTitleText": "加入群组"
      }
    },
    {
      "path": "pages/group/create",
      "style": {
        "navigationBarTitleText": "创建群组"
      }
    },
    {
      "path": "pages/mine/signups",
      "style": {
        "navigationBarTitleText": "我的报名记录",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/mine/bills",
      "style": {
        "navigationBarTitleText": "待付款"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "组局助手",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F6F8",
    "backgroundTextStyle": "dark"
  },
  // 底部导航
  "tabBar": {
    "color": "#5C5C5C",
    "selectedColor": "#2F6BE6",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "球局",
        "iconPath": "static/tabbar/game.png",
        "selectedIconPath": "static/tabbar/game-active.png"
      },
      {
        "pagePath": "pages/group/index",
        "text": "群组",
        "iconPath": "static/tabbar/group.png",
        "selectedIconPath": "static/tabbar/group-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  }
}
